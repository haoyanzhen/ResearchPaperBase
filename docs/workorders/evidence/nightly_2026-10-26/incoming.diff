+        url + "/action-preview",
+        headers=h,
+        json={"action": action, "expected_revision": project["revision"]},
+    )
+
+
+def confirmed(value):
+    return {
+        "expected_revision": value["subject_revision"],
+        "confirmation_token": value["confirmation_token"],
+        "acknowledged_risk_ids": [r["id"] for r in value["risks"]],
+    }
